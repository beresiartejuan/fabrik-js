# Copia este archivo a `.env` (`cp .env.example .env`) y ajústalo si hace falta.
# `.env` está ignorado por git; este ejemplo es el default de desarrollo.

# --- Auth (obligatorias fuera de tests) -------------------------------------
# Genera secretos fuertes, p. ej. `openssl rand -hex 32`.
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000

# --- Bootstrap de admin (opcional, desarrollo/e2e) --------------------------
# Crea el admin SOLO si no existe; nunca actualiza rol ni contraseña.
BOOTSTRAP_ADMIN_NAME=admin
BOOTSTRAP_ADMIN_PASSWORD=admin123

# --- Persistencia -----------------------------------------------------------
# Relativa al cwd del proceso (normalmente apps/api); se crea si no existe.
FABRIK_DB_FILE=./data/fabrik.db

# --- HTTP -------------------------------------------------------------------
PORT=3001
# Orígenes permitidos por CORS (coma-separados). En producción, defínela.
CORS_ORIGINS=http://localhost:3000

# --- Tests/e2e --------------------------------------------------------------
# Solo para tests deterministas de la ventana I3: honra el `timestamp` del cuerpo
# en POST /production/transform. Déjalo apagado en desarrollo/producción.
# FABRIK_ALLOW_CLIENT_TIMESTAMP=true
