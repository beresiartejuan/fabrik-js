{
  "name": "@fabrik/domain",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Capa de dominio compartida de Fabrik: entidades, value objects, casos de uso, eventos y puertos. Cero dependencias de runtime.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "dev": "vitest"
  },
  "devDependencies": {
    "typescript": "^6.0.2",
    "vitest": "^4.1.2"
  }
}
