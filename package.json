{
  "name": "fabrik-js",
  "private": true,
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "check": "biome check .",
    "format": "biome format --write .",
    "check:fix": "biome check --write .",
    "test": "turbo run test",
    "dev:web": "pnpm --filter web dev",
    "dev:web-demo": "pnpm --filter @fabrik/web-demo dev",
    "dev:api": "pnpm --filter api start:dev"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "turbo": "^2.5.8"
  }
}
